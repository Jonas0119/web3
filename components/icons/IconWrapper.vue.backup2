<template>
  <view 
    class="icon-wrapper"
    :style="wrapperStyle"
    @click="handleClick"
  >
    <text 
      v-if="isIconify" 
      class="iconify" 
      :class="iconClasses"
      :style="iconStyle"
    >
      {{ getIconContent() }}
    </text>
    <text 
      v-else 
      :class="['iconfont', name]"
      :style="iconStyle"
    ></text>
  </view>
</template>

<script>
import { MDI_CONFIG } from '../../plugins/iconify'
import { getIconSize, getThemeColor } from '../../utils/iconConfig'

// 添加全局字体加载状态
let isFontLoaded = false;

export default {
  name: 'IconWrapper',
  props: {
    // 图标名称
    name: {
      type: String,
      required: true
    },
    // 图标大小
    size: {
      type: [Number, String],
      default: 32
    },
    // 图标颜色
    color: {
      type: String,
      default: 'currentColor'
    },
    // 自定义样式
    customStyle: {
      type: Object,
      default: () => ({})
    },
    // 主题
    theme: {
      type: String,
      default: 'light'
    },
    // 是否启用动画
    animated: {
      type: Boolean,
      default: false
    },
    // 旋转角度
    rotate: {
      type: [Number, String],
      default: 0
    }
  },
  computed: {
    // 判断是否为 Iconify 图标
    isIconify() {
      return this.name.startsWith('mdi:')
    },
    // 图标类名
    iconClasses() {
      return {
        'mdi': true,
        [`mdi-${this.getMdiName()}`]: true,
        'animated': this.animated
      }
    },
    // 包装器样式
    wrapperStyle() {
      const size = getIconSize(this.size)
      return {
        width: size + 'rpx',
        height: size + 'rpx',
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        ...this.customStyle
      }
    },
    // 图标样式
    iconStyle() {
      const size = getIconSize(this.size)
      const color = this.color === 'currentColor' ? this.color : getThemeColor(this.color, this.theme)
      
      return {
        fontSize: size + 'rpx',
        color: color,
        transform: this.rotate ? `rotate(${this.rotate}deg)` : 'none',
        transition: this.animated ? 'all 0.3s ease' : 'none'
      }
    }
  },
  methods: {
    handleClick(event) {
      this.$emit('click', event)
    },
    getMdiName() {
      return this.name.replace('mdi:', '')
    },
    getIconContent() {
      const iconName = this.getMdiName()
      return MDI_CONFIG.icons[iconName] || ''
    },
    async loadFont() {
      // 如果字体已加载，直接返回
      if (isFontLoaded) {
        return;
      }

      try {
        await new Promise((resolve, reject) => {
          uni.loadFontFace({
            family: 'Material Design Icons',
            source: 'url("https://cdn.jsdelivr.net/npm/@mdi/font@7.2.96/fonts/materialdesignicons-webfont.woff2")',
            success() {
              console.log('字体加载成功');
              resolve();
            },
            fail(error) {
              console.error('字体加载失败:', error);
              reject(error);
            }
          });
        });
        
        // 设置全局加载状态
        isFontLoaded = true;
      } catch (error) {
        console.error('字体加载出错:', error);
      }
    }
  },
  mounted() {
    this.loadFont();
  }
}
</script>

<style>
.icon-wrapper {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.iconify {
  font-family: 'Material Design Icons';
  font-style: normal;
  line-height: 1;
  display: inline-block;
}

.iconify.animated {
  animation: iconPulse 2s infinite;
}

@keyframes iconPulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1);
  }
}

/* 错误状态样式 */
.icon-wrapper.error .iconify {
  color: #ff3b30;
}

/* 成功状态样式 */
.icon-wrapper.success .iconify {
  color: #4cd964;
}

/* 警告状态样式 */
.icon-wrapper.warning .iconify {
  color: #ff9500;
}
</style>
